#!/bin/sh
# Git pre-push hook — runs syntax check before allowing push
# Install: git config core.hooksPath .githooks

echo "Running syntax check..."
node scripts/check-syntax.mjs
if [ $? -ne 0 ]; then
    echo ""
    echo "Push blocked: syntax check failed."
    echo "Fix the errors above, or use --no-verify to bypass."
    exit 1
fi
