# Ignore all dot-prefixed files and directories (except .git and .gitignore itself)
.*
!.git
!.gitignore

# Python
__pycache__/
*.pyc
*.bak

# Editor / OS
.DS_Store
.env
*.swp

# Local dev
.qwenref/
docs/_localmodel/

# Playwright
playwright-tests/test-results/
playwright-tests/playwright-report/

# CPU/WASM ternary engine — large / regenerable artifacts (NEVER commit).
# NOTE: cpukern.wasm + cpukern-shared.wasm ARE committed (8KB kernels, version-locked
# to _cpukern/cpuengine-mt.js — rebuild recipe in _cpukern/src/lib.rs header).
_bonsai17/
_hf/
*.cpu.bin
_cpukern/target/
test/lang-harness/.env

# Bergamot model packs are hosted on sandpie-server static (server-side, untracked), not in git
/bergamot-models/
